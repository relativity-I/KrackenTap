<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Надпись прямо НАД кракеным -->
    <TextView
        android:id="@+id/textTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Атакуй кракена"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <!-- Контейнер = размеру кракена. clipChildren=false — чтобы числа
         могли вылетать за его пределы -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/kraken"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/krakentaptap"
            android:contentDescription="kraken" />

    </FrameLayout>

    <!-- Подпись прямо ПОД кракеным -->
    <TextView
        android:id="@+id/textDown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Урон: 0"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FF2222" />

</LinearLayout>